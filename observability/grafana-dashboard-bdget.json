      {
        "id": 9,
        "title": "Disponibilidad (respuestas sin error 5xx)",
        "type": "stat",
        "datasource": "Prometheus",
        "gridPos": {
          "x": 0,
          "y": 6,
          "w": 6,
          "h": 5
        },
        "targets": [
          {
            "expr": "100 * sum(rate(istio_requests_total{destination_workload=\"bdget-deployment\",reporter=\"destination\",response_code!~\"5..\"}[5m])) / sum(rate(istio_requests_total{destination_workload=\"bdget-deployment\",reporter=\"destination\"}[5m]))",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 95
                },
                {
                  "color": "green",
                  "value": 99
                }
              ]
            }
          },
          "overrides": []
