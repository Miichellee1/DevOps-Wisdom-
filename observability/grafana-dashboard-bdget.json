{
  "dashboard": {
    "uid": "bdget-devops",
    "title": "bdget - DevOps (CI/CD y operación en EKS)",
    "tags": [
      "bdget",
      "devops",
      "eks"
    ],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-30m",
      "to": "now"
    },
    "schemaVersion": 39,
    "panels": [
      {
        "id": 1,
        "type": "row",
        "title": "Pipeline CI/CD (último despliegue)",
        "collapsed": false,
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": []
      },
      {
        "id": 2,
        "title": "Cobertura de pruebas",
        "type": "stat",
        "datasource": "Prometheus",
        "gridPos": {
          "x": 0,
          "y": 1,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "expr": "ci_test_coverage_percent",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 60
                },
                {
                  "color": "green",
                  "value": 80
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "value"
        },
        "description": "Cobertura de líneas medida por JaCoCo en el pipeline. Mínimo exigido: 80%."
      },
      {
